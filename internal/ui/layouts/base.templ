package layouts

templ BaseLayout(title string) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{ title }</title>
        <link rel="stylesheet" href="/static/css/styles.css">
    </head>
    <body>
        <main>
            { children... }
        </main>
    </body>
    </html>
}
